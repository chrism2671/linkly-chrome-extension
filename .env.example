# Copy to .env (gitignored) and fill in the secrets. Used by scripts/release.mjs.

# Chrome Web Store (publishing API v2)
CWS_EXTENSION_ID=eafdoeojplandfjbmjkglljhlckoajcg
CWS_PUBLISHER_ID=34e8e407-6835-4d5c-8305-87beb5c88735

# Preferred: a service account impersonated through gcloud (no secret stored).
# It must be added in the Web Store developer dashboard's account settings, and
# your gcloud user needs Service Account Token Creator on it.
CWS_SERVICE_ACCOUNT=linkly-extension-release@hardy-thunder-248711.iam.gserviceaccount.com
# CLOUDSDK_PYTHON=python3.11   # only if gcloud crashes on your default Python

# Alternative if not using a service account: OAuth client (Desktop app) plus a
# refresh token written by `node scripts/cws-auth.mjs`.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Firefox AMO: https://addons.mozilla.org/en-GB/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
AMO_ADDON_ID={07141a83-86cc-4ed7-b4ba-2035e55b493f}
