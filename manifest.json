{
  "name": "Linkly",
  "version": "1.4",
  "description": "Making any link a tracking link",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "action": {
    "default_title": "Create Linkly Link",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://*.linklyhq.com/*"
    ]
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "14.0"
    }
  }
}
